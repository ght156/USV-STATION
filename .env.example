# Backend Server Configuration
HOST=0.0.0.0
PORT=5002

# Frontend Configuration
# Optional - automatically matches backend PORT if not set
VITE_API_PORT=5002
# When UI is loaded via file:// (packaged Electron), set API host explicitly, e.g. 127.0.0.1
# VITE_API_HOST=127.0.0.1
# 天地图开放平台「浏览器端」Key（三维影像 + DEM 地形），参见 https://console.tianditu.gov.cn/
VITE_TIANDITU_TOKEN=your_tianditu_browser_key_here

# 已不再使用 Ion 默认全球底图；保留字段仅占位，可删除。
# VITE_CESIUM_ION_TOKEN=